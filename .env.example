# Supabase: pooled transaction URL for Vercel runtime, direct/session URL for migrations.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public business contact (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="BaliXperience <bookings@your-domain.com>"

# Used to hash rate-limit identifiers before storing them.
RATE_LIMIT_SALT="replace-with-a-long-random-secret"

# Solo-operator admin. Generate a scrypt hash before seeding the User row.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Local preview only. Never enable this in Vercel.
ADMIN_PREVIEW_MODE="false"
